# ============================================
# Site de Produtos - Variáveis de Ambiente
# Copie para .env.local e preencha os valores reais
# ============================================

# Site
NEXT_PUBLIC_SITE_URL=https://melpropolis.cia.com.br
NEXT_PUBLIC_SITE_NAME=Apiários & Cia

# Contatos
NEXT_PUBLIC_WHATSAPP=5511999999999
NEXT_PUBLIC_EMAIL=contato@melpropolis.cia.com.br
NEXT_PUBLIC_INSTAGRAM=@melpropolis.cia

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=

# ============================================
# INTEGRAÇÕES (capture de leads)
# ============================================

# Google Apps Script Webhook URL (temporário)
# Gerado no Google Sheets: Extensões > Apps Script > Implantar > Web App
GOOGLE_APPS_SCRIPT_URL=

# SendPulse API (futuro, após compra do domínio)
# SENDPULSE_CLIENT_ID=
# SENDPULSE_CLIENT_SECRET=
# SENDPULSE_BOOK_ID=
# SENDPULSE_DOUBLE_OPTIN=true

# Configurações de produtos
NEXT_PUBLIC_SHOW_PRICES=true
